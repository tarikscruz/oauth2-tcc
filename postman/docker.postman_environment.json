{
    "id": "docker-env",
    "name": "Docker",
    "values": [
        {
            "key": "base_url",
            "value": "http://api:8000",
            "enabled": true
        },
        {
            "key": "client_id",
            "value": "postman-public-client",
            "enabled": true
        },
        {
            "key": "redirect_uri",
            "value": "http://localhost:8000/postman/callback",
            "enabled": true
        },
        {
            "key": "scope",
            "value": "profile:read offline_access",
            "enabled": true
        }
    ]
}